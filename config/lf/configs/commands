cmd "convertir a mp4" &{{
    . ~/.config/lf/scripts/utils.sh
    while IFS= read -r file; do
        aviso " 󱥸  convirtiendo $(basename -- "$file") a mp4..."
        ffmpeg -nostdin -i "$file" -c:v libx264 -pix_fmt yuv420p -b:v 12M -b:a 192k -c:a aac "${file%.*}.mp4"
    done <<< "$fx"
    lf -remote "send $id :reload;unselect"
    lf -remote "send $id echo '   conversión a mp4 completada'"
