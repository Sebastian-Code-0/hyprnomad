# ---------- RIPGREP ----------

cmd ripgrep ${{
    . ~/.config/lf/scripts/utils.sh
    cmd="rg --column --line-number --no-heading --color=always --smart-case"
    fzf --ansi --disabled --layout=reverse --header="Buscar en archivos" --delimiter=: \
        --bind="start:reload([ -n {q} ] && $cmd -- {q} || true)" \
        --bind="change:reload([ -n {q} ] && $cmd -- {q} || true)" \
        --bind='enter:become(~/.config/lf/scripts/seleccionar.sh "$id" {1})' \
        --preview='bat --color=always --style=numbers --pager=never --highlight-line {2} -- {1}' \
        --preview-window='+{2}/2' || true
}}



