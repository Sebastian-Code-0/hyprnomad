# ---------- USB ----------

cmd "ir a usb" ${{
    . ~/.config/lf/scripts/utils.sh
    ir_a "/run/media/$USER"
}}

cmd "desmontar usb" &{{
    if [[ "$PWD" != /run/media/* ]]; then
        lf -remote "send $id echo '   párate dentro de la USB primero (iu → entrar a la carpeta)'"
        exit 1
    fi
    dev=$(findmnt -n -o SOURCE --target "$PWD" 2>/dev/null)
    if [ -z "$dev" ] || [ "$dev" = "run" ]; then
        lf -remote "send $id echo '   no se detectó ningún dispositivo en esta ruta'"
        exit 1
    fi
    lf -remote "send $id cd ~"
    cd ~
    sleep 1
    udisksctl unmount -b "$dev" &&
    udisksctl power-off -b "$dev" &&
    notify-send "lf gestor de archivos" "USB desmontada de forma segura" &&
    lf -remote "send $id echo '   USB desmontada de forma segura'" ||
    lf -remote "send $id echo '   error al desmontar: cierra todos los archivos de la USB e intenta de nuevo'"
}}



