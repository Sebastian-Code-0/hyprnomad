# ---------- ARCHIVOS COMPRIMIDOS ----------

cmd "crear zip" %{{
    . ~/.config/lf/scripts/utils.sh
    printf " 󱝣  nombre del archivo ZIP: "
    read -r ans
    [ -n "$ans" ] || { echo "   cancelado"; exit 0; }
    origd="$(pwd)"
    tempd="$(mktemp -d)" || exit 1
    pushd "$tempd" > /dev/null || exit 1
    while IFS= read -r file; do rsync -arhz --info=progress2 -- "$file" .; done <<< "$fx"
    7z a -r -tzip -- "$ans" ./*
    rsync -arhz --info=progress2 -- "$ans".zip "$origd/"
    popd > /dev/null
    rm -rf "$tempd"
    lf -remote "send $id :reload;unselect"
    aviso " 󱝣  ZIP \"$ans.zip\" creado"
}}

cmd "crear zip cifrado" ${{
    . ~/.config/lf/scripts/utils.sh
    printf " 󱝣  nombre del ZIP cifrado: "
    read -r ans
    [ -n "$ans" ] || exit 0
    origd="$(pwd)"
    tempd="$(mktemp -d)" || exit 1
    pushd "$tempd" > /dev/null || exit 1
    while IFS= read -r file; do rsync -arhz --info=progress2 -- "$file" .; done <<< "$fx"
    7z a -mem=AES256 -mx4 -tzip -p -- "$ans" ./*
    rsync -arhz --info=progress2 -- "$ans".zip "$origd/"
    popd > /dev/null
    rm -rf "$tempd"
    lf -remote "send $id :reload;unselect"
    aviso " 󱝣  ZIP cifrado \"$ans.zip\" creado"
}}

cmd "extraer archivo comprimido" &{{
    while IFS= read -r file; do
        case $file in
            *.zip) 7z x -aou -o"${file%.zip}" -- "$file" ;;
            *.7z) 7z x -aou -o"${file%.7z}" -- "$file" ;;
            *.rar) 7z x -aou -o"${file%.rar}" -- "$file" ;;
            *.tar.zst) tar --zstd -xf "$file" --one-top-level ;;
            *.tar.gz) tar -xzf "$file" --one-top-level ;;
            *.tar.xz) tar -xf "$file" --one-top-level ;;
            *.tar.bz2) tar -xjf "$file" --one-top-level ;;
            *.gz) gunzip -k -- "$file" ;;
            *.tar) tar -xf "$file" --one-top-level ;;
            *) lf -remote "send $id echo '   formato no soportado'" ;;
        esac
    done <<< "$fx"
    lf -remote "send $id :reload;unselect"
    lf -remote "send $id echo '   archivo(s) extraído(s) correctamente'"
}}



