    while IFS= read -r file; do chmod u+x -- "$file"; done <<< "$fx"
    lf -remote "send $id reload"
}}



# ---------- CREAR BACKUP ----------

cmd "crear respaldo" &{{
    . ~/.config/lf/scripts/utils.sh


    nof=$(printf '%s\n' "$fx" | wc -l)

    while IFS= read -r file; do
        aviso " 󱥸  creando backup de $(basename -- "$file")..."
