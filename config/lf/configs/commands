# ---------- PAPELERA ----------
# Usa la papelera estándar del sistema (XDG, ~/.local/share/Trash) vía trash-cli.
# Requiere: sudo pacman -S trash-cli

cmd trash %{{


    nof=$(echo "$fx" | wc -l)

    printf "   mover $nof archivo(s) a la papelera? [s/n] "
    read -r ans
    if [ "$ans" = "s" ]; then
        failed=0
        while IFS= read -r file; do
            err=$(trash-put -- "$file" 2>&1) || { echo "   error: \"$(basename "$file")\" — $err"; failed=1; }
        done <<< "$fx"
        lf -remote "send $id :reload;unselect"
        if [ $failed -eq 0 ]; then
            echo "   movido a la papelera correctamente"
            notify-send "lf gestor de archivos" "   $nof archivo(s) movido(s) a la papelera" -i "user-trash-symbolic"
        fi
    else
        echo "   cancelado"
    fi
}}

cmd "restaurar de papelera" %{{
    INFO_DIR="$HOME/.local/share/Trash/info"
    FILES_DIR="$HOME/.local/share/Trash/files"

    restore_one() {
        nombre="$1"
        info="$INFO_DIR/$nombre.trashinfo"
        if [ ! -f "$info" ]; then
            echo "   no se encontró información de \"$nombre\" en la papelera"
            return 1
        fi

        origen_codificado=$(grep "^Path=" "$info" | cut -d= -f2-)
        origen=$(printf '%b' "${origen_codificado//%/\\x}")

        if [ -e "$origen" ]; then
            echo "   ya existe un archivo en \"$origen\", se canceló para no sobrescribir nada"
            return 1
        fi

        mkdir -p "$(dirname "$origen")"
        if mv -- "$FILES_DIR/$nombre" "$origen"; then
            rm -f "$info"
            echo "   restaurado: $nombre"
            return 0
        else
            echo "   error al restaurar \"$nombre\""
            return 1
        fi
    }

    # parado dentro de la papelera: restaura directo el/los archivo(s) bajo el cursor, sin pedir número
    # (se queda en modo shell-pipe, mensajes lindos abajo en lf, sin pantalla completa)
    if [ "$(pwd)" = "$FILES_DIR" ]; then
        nof=$(echo "$fx" | wc -l)
        printf "   restaurar %s archivo(s)? [s/n] " "$nof"
        read -r ans
        if [ "$ans" != "s" ]; then
            echo "   cancelado"
            exit 0
        fi

        ok=0
        while IFS= read -r file; do
            restore_one "$(basename "$file")" && ok=$((ok + 1))
        done <<< "$fx"

        lf -remote "send $id :reload;unselect"
        if [ "$ok" -gt 0 ]; then
            notify-send "lf gestor de archivos" "   $ok archivo(s) restaurado(s)" -i "document-revert-symbolic"
        fi
        exit 0
    fi

    # fuera de la papelera: necesita pantalla completa para que fzf funcione,
    # así que se lo pasamos al comando hermano que corre en modo terminal completa
    if [ -z "$(ls -A "$INFO_DIR" 2>/dev/null)" ]; then
        echo "   la papelera está vacía, no hay nada que restaurar"
        exit 0
    fi
    lf -remote "send $id restaurar-papelera-fzf"
}}

cmd restaurar-papelera-fzf ${{
    . ~/.config/lf/scripts/utils.sh
    INFO_DIR="$HOME/.local/share/Trash/info"
    FILES_DIR="$HOME/.local/share/Trash/files"

    msg() { aviso "$1"; }

    clear

    seleccion=$(
        for info in "$INFO_DIR"/*.trashinfo; do
            nombre=$(basename "$info" .trashinfo)
            fecha=$(grep "^DeletionDate=" "$info" | cut -d= -f2 | tr 'T' ' ')
            printf '%s\t(borrado: %s)\n' "$nombre" "$fecha"
        done | fzf --border --header='  restaurar de la papelera' --delimiter='\t' --with-nth=1,2 \
            --preview="$HOME/.config/lf/previewer/fzf_trash_preview.sh $HOME/.local/share/Trash/files/{1}" \
            --preview-window='right:50%'
    )

    if [ -z "$seleccion" ]; then
        msg "   cancelado"
        exit 0
    fi
    nombre=$(printf '%s' "$seleccion" | cut -f1)

    printf "   restaurar \"%s\"? [s/n] " "$nombre"
    read -r ans
    if [ "$ans" != "s" ]; then
        msg "   cancelado"
        exit 0
    fi

    info="$INFO_DIR/$nombre.trashinfo"
    origen_codificado=$(grep "^Path=" "$info" | cut -d= -f2-)
    origen=$(printf '%b' "${origen_codificado//%/\\x}")

    if [ -e "$origen" ]; then
        msg "   ya existe un archivo en \"$origen\", se canceló para no sobrescribir nada"
        exit 1
    fi

    mkdir -p "$(dirname "$origen")"
    if mv -- "$FILES_DIR/$nombre" "$origen"; then
        rm -f "$info"
        lf -remote "send $id :reload;unselect"
        msg "   restaurado: $nombre"
        notify-send "lf gestor de archivos" "Se restauró \"$nombre\"" -i "document-revert-symbolic"
    else
        msg "   error al restaurar \"$nombre\""
    fi
}}

cmd "vaciar papelera" %{{
    printf "   vaciar la papelera completa? esto NO se puede deshacer [s/n] "
    read -r ans
    if [ "$ans" = "s" ]; then
        trash-empty -f 0
        echo "   papelera vaciada"
    else
        echo "   cancelado"
    fi
}}



