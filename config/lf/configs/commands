# ---------- ABRIR ----------

cmd open &{{
    case $(file --mime-type -Lb "$f") in
        image/*) swayimg "$f" ;;
        text/*|application/json) kitty --override window_padding_width=0 nvim "$f" ;;
        *) xdg-open "$f" ;;
    esac
}}



