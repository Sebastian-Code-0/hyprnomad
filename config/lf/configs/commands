    done <<< "$fx"
    lf -remote "send $id :reload;unselect"
    aviso "   $nof backup(s) creado(s) correctamente"
    notify-send "lf gestor de archivos" "   $nof backup(s) creado(s) correctamente" -i "document-save-symbolic"
}}



