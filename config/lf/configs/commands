# ---------- COPIAR CON PROGRESO ----------

#require rsync

cmd paste &{{
    . ~/.config/lf/scripts/utils.sh
    mapfile -t _lines < ~/.local/share/lf/files
    mode="${_lines[0]}"
    files=("${_lines[@]:1}")


    if [[ ${#files[@]} -gt 0 ]]; then
        lf -remote "send $id echo ' 󱥸  calculando archivos...'"
        nof=$(rsync -ar --dry-run --stats -- "${files[@]}" . | grep -F 'Number of files' |    cut -d' ' -f4 |    tr -d ,)

        case "$mode" in
            copy)
                for file in "${files[@]}"; do
                    if ! [[ -O "$file" ]]; then
                        printf "   al copiar estos archivos el propietario cambiará al usuario actual. ¿continuar? (s/n) "
                        read -r ans
                        if [ "$ans" = "s" ]; then
                            rsync -arhz --info=progress2 -- "${files[@]}" . |
                            stdbuf -i0 -o0 -e0 tr '\r' '\n' |
                            while IFS= read -r line; do
                                aviso " 󰆏 $line"
                            done

                            lf -remote "send $id :clear;reload"
                            aviso "   $nof archivo(s) copiado(s) correctamente"
                            notify-send "lf gestor de archivos" "   $nof archivo(s) copiado(s) correctamente" -i "edit-copy-symbolic"
                            rm -f ~/.local/share/lf/files
                            exit 0
                        else
                            lf -remote "send $id echo '   permiso denegado: uno o más archivos no te pertenecen y no pueden copiarse'"
                            exit 1
                        fi
                    fi
                done

                rsync -arh --info=progress2 -- "${files[@]}" . |
                stdbuf -i0 -o0 -e0 tr '\r' '\n' |
                while IFS= read -r line; do
                    aviso " 󰆏 $line"
                done

                lf -remote "send $id :clear;reload"
                aviso "   $nof archivo(s) copiado(s) correctamente"
                notify-send "lf gestor de archivos" "   $nof archivo(s) copiado(s) correctamente" -i "edit-copy-symbolic"
                rm -f ~/.local/share/lf/files
                exit 0
                ;;
        move)
            for file in "${files[@]}"; do
                if ! [[ -O "$file" ]]; then
                    lf -remote "send $id echo '   permiso denegado: uno o más archivos no te pertenecen y no pueden moverse'"
                    exit 1
                fi
            done

            rsync -arhz --info=progress2 --remove-source-files -- "${files[@]}" . |
            stdbuf -i0 -o0 -e0 tr '\r' '\n' |
            while IFS= read -r line; do
               aviso " 󱀱 $line"
            done

            if [ -n "$(find "${files[@]}" -type f 2>/dev/null)" ]; then
                lf -remote "send $id echo '   no todos los archivos fueron movidos'";
            else
                find "${files[@]}" -type d -empty -delete 2>/dev/null
            fi

            lf -remote "send $id :clear;reload"
            aviso "   $nof archivo(s) movido(s) correctamente"
            notify-send "lf gestor de archivos" "   $nof archivo(s) movido(s) correctamente" -i "send-to-symbolic"
            rm -f ~/.local/share/lf/files
            exit 0
            ;;
        esac
    else
        exit 1
    fi
}}



