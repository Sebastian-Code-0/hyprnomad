    . ~/.config/lf/scripts/utils.sh
    for d in "$(xdg-user-dir DOWNLOAD)" "$(xdg-user-dir PICTURES)/Screenshots"; do
        e=$(lf_escapar "$d")
        lf -remote "send $id setlocal \"$e\" sortby time"
        lf -remote "send $id setlocal \"$e\" reverse"
    done
}}



