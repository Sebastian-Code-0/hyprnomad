// fastfetch: informacion del sistema junto al logo que rota run.sh
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty",
        "height": 10,
        "padding": { "top": 3, "left": 4, "right": 2 }
    },
    "display": { "separator": " " },
    "modules": [
        "break",
        { "type": "title", "keyWidth": 10 },
        "break",
        {
            "type": "custom",
            "format": "\u001b[2m─── sistema ──────────────────────\u001b[0m"
        },
        {
            "type": "os",
            "key": "  ",
            "keyColor": "34"
        },
        {
            "type": "kernel",
            "key": "  ",
            "keyColor": "34"
        },
        {
            "type": "uptime",
            "key": "󱎫  ",
            "keyColor": "34"
        },
        {
            "type": "packages",
            "key": "  ",
            "keyColor": "34"
        },
        {
            "type": "shell",
            "key": "  ",
            "keyColor": "34"
        },
        {
            "type": "custom",
            "format": "\u001b[2m─── escritorio ───────────────────\u001b[0m"
        },
        {
            "type": "wm",
            "key": "  ",
            "keyColor": "34"
        },
        {
            "type": "terminal",
            "key": "  ",
            "keyColor": "34"
        },
        {
            "type": "terminalfont",
            "key": "  ",
            "keyColor": "34"
        },
        {
            "type": "display",
            "key": "󰍹  ",
            "keyColor": "34"
        },
        {
            "type": "media",
            "key": "  ",
            "keyColor": "34"
        },
        {
            "type": "custom",
            "format": "\u001b[2m─── equipo ───────────────────────\u001b[0m"
        },
        {
            "type": "host",
            "key": "󰌢  ",
            "keyColor": "34"
        },
        {
            "type": "cpu",
            "key": "  ",
            "keyColor": "34"
        },
        {
            "type": "gpu",
            "key": "󰢮  ",
            "keyColor": "34"
        },
        {
            "type": "memory",
            "key": "󰍛  ",
            "keyColor": "34"
        },
        {
            "type": "disk",
            "key": "  ",
            "keyColor": "34"
        },
        {
            "type": "battery",
            "key": "󰁹  ",
            "keyColor": "34"
        },
        "break",
        { "type": "colors", "symbol": "circle", "paddingLeft": 2 },
        "break"
    ]
}
